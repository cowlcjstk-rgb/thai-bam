---
interface Props {
  kakaoUrl?: string;
  lineUrl?: string;
  inquiryHref?: string;
}

const { kakaoUrl, lineUrl, inquiryHref = '#venue-inquiry' } = Astro.props;

const channels = [
  { name: '카카오톡 문의', url: kakaoUrl, className: 'kakao' },
  { name: '라인 문의', url: lineUrl, className: 'line' },
];
---

<section class="contact-banner" aria-label="문의 배너">
  <p class="contact-banner-title">빠른 문의</p>
  <p class="contact-banner-subtitle">카카오톡 / 라인 링크는 곧 추가됩니다.</p>

  <div class="contact-banner-grid">
    {channels.map((channel) =>
      channel.url ? (
        <a class={`contact-button ${channel.className}`} href={channel.url} target="_blank" rel="nofollow noopener noreferrer">
          {channel.name}
        </a>
      ) : (
        <button class={`contact-button ${channel.className}`} type="button" disabled>
          {channel.name}
          <span>링크 준비중</span>
        </button>
      )
    )}
  </div>
</section>

<nav class="mobile-quick-cta" aria-label="모바일 문의 바로가기">
  {kakaoUrl ? (
    <a class="mobile-cta kakao" href={kakaoUrl} target="_blank" rel="nofollow noopener noreferrer">카톡 문의</a>
  ) : (
    <button class="mobile-cta kakao" type="button" disabled>카톡 준비중</button>
  )}

  {lineUrl ? (
    <a class="mobile-cta line" href={lineUrl} target="_blank" rel="nofollow noopener noreferrer">라인 문의</a>
  ) : (
    <button class="mobile-cta line" type="button" disabled>라인 준비중</button>
  )}

  <a class="mobile-cta inquiry" href={inquiryHref}>문의 안내</a>
</nav>
<div class="mobile-quick-cta-spacer" />

<style>
  .contact-banner {
    margin: 20px 0;
    padding: 18px;
    border-radius: 16px;
    border: 1px solid #d6e4ff;
    background: linear-gradient(140deg, #eff6ff 0%, #f8fafc 100%);
  }

  .contact-banner-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
  }

  .contact-banner-subtitle {
    margin: 6px 0 14px;
    font-size: 0.93rem;
    color: #475569;
  }

  .contact-banner-grid {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .contact-button {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 72px;
    border: 0;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.18s ease, filter 0.18s ease;
  }

  .contact-button span {
    margin-top: 4px;
    font-size: 0.76rem;
    font-weight: 500;
    opacity: 0.9;
  }

  .contact-button:disabled {
    cursor: not-allowed;
    opacity: 0.95;
  }

  .contact-button:not(:disabled):hover {
    transform: translateY(-2px);
    filter: brightness(1.02);
  }

  .kakao {
    background: #fee500;
    color: #1a1a1a;
  }

  .line {
    background: #06c755;
    color: #ffffff;
  }

  .mobile-quick-cta {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 60;
    display: none;
    gap: 8px;
    padding: 8px;
    border-radius: 14px;
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(6px);
  }

  .mobile-cta {
    flex: 1;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 44px;
    border: 0;
    border-radius: 10px;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .mobile-cta.inquiry {
    background: #f8fafc;
    color: #0f172a;
  }

  .mobile-cta:disabled {
    opacity: 0.72;
    cursor: not-allowed;
  }

  .mobile-quick-cta-spacer {
    display: none;
    height: 74px;
  }

  @media (max-width: 720px) {
    .contact-banner-grid {
      grid-template-columns: 1fr;
    }

    .mobile-quick-cta {
      display: flex;
    }

    .mobile-quick-cta-spacer {
      display: block;
    }
  }
</style>
