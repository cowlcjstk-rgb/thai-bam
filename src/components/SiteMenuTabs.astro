---
import { getCollection } from 'astro:content';

const [areasRaw, categoriesRaw, venuesRaw] = await Promise.all([
  getCollection('areas'),
  getCollection('categories'),
  getCollection('venues'),
]);

const areas = areasRaw.sort((a, b) => a.data.order - b.data.order);
const categories = categoriesRaw.sort((a, b) => a.data.order - b.data.order);
const visibleVenues = venuesRaw.filter((venue) => venue.data.visible);

const normalizePath = (value) => {
  if (!value) return '/';
  return value.endsWith('/') ? value : `${value}/`;
};

const pathname = normalizePath(Astro.url.pathname);
const currentAreaSlug = areas.find((area) => pathname.startsWith(`/${area.slug}/`))?.slug ?? '';

const isExactActive = (href) => pathname === normalizePath(href);
const isCategoryActive = (areaSlug, categorySlug) => pathname.startsWith(`/${areaSlug}/${categorySlug}/`);

const areaCategoryMap = areas.reduce((acc, area) => {
  const availableCategorySlugs = new Set(
    visibleVenues.filter((venue) => venue.data.area === area.slug).map((venue) => venue.data.category),
  );

  acc[area.slug] = categories.filter((category) => availableCategorySlugs.has(category.slug));
  return acc;
}, {});
---

<nav class="site-menu-tabs" data-site-menu-tabs data-current-area={currentAreaSlug} aria-label="사이트 메뉴">
  <div class="menu-top-row">
    <button type="button" class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="site-menu-panel">
      메뉴
    </button>
  </div>

  <div class="menu-panel" id="site-menu-panel" data-menu-panel hidden>
    <div class="menu-section-title">지역 선택</div>
    <div class="menu-region-list" data-region-list>
      <a class:list={{ active: isExactActive('/') }} href="/">홈</a>
      {areas.map((area) => (
        <button
          type="button"
          data-area-trigger={area.slug}
          data-area-name={area.data.name}
          class:list={{ active: area.slug === currentAreaSlug }}
          aria-pressed={area.slug === currentAreaSlug ? 'true' : 'false'}
        >
          {area.data.name}
        </button>
      ))}
    </div>

    <div class="menu-category-wrap" data-category-wrap hidden>
      <p class="menu-section-title" data-category-title>카테고리 선택</p>
      {areas.map((area) => (
        <ul class="category-panel" data-area-panel={area.slug} hidden>
          {areaCategoryMap[area.slug].map((category) => (
            <li>
              <a class:list={{ active: isCategoryActive(area.slug, category.slug) }} href={`/${area.slug}/${category.slug}/`}>
                {category.data.name}
              </a>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</nav>

<script type="module">
  const menuTabs = document.querySelector('[data-site-menu-tabs]');
  if (!menuTabs) {
    return;
  }

  const root = document.documentElement;
  const menuToggle = menuTabs.querySelector('[data-menu-toggle]');
  const menuPanel = menuTabs.querySelector('[data-menu-panel]');
  const categoryWrap = menuTabs.querySelector('[data-category-wrap]');
  const categoryTitle = menuTabs.querySelector('[data-category-title]');
  const areaButtons = Array.from(menuTabs.querySelectorAll('[data-area-trigger]'));
  const areaPanels = Array.from(menuTabs.querySelectorAll('[data-area-panel]'));

  const setMenuOpen = (isOpen) => {
    menuToggle?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    if (menuPanel) {
      menuPanel.hidden = !isOpen;
    }
    updateMenuTabHeight();
  };

  const activateArea = (areaSlug, areaName) => {
    areaButtons.forEach((button) => {
      const isActive = button.dataset.areaTrigger === areaSlug;
      button.classList.toggle('active', isActive);
      button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });

    areaPanels.forEach((panel) => {
      panel.hidden = panel.dataset.areaPanel !== areaSlug;
    });

    if (categoryWrap) {
      categoryWrap.hidden = !areaSlug;
    }

    if (categoryTitle) {
      categoryTitle.textContent = areaSlug ? `${areaName} 카테고리` : '카테고리 선택';
    }

    updateMenuTabHeight();
  };

  const updateMenuTabHeight = () => {
    const height = Math.ceil(menuTabs.getBoundingClientRect().height);
    root.style.setProperty('--site-menu-tabs-height', `${height}px`);
  };

  menuToggle?.addEventListener('click', () => {
    const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!isOpen);
  });

  areaButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const slug = button.dataset.areaTrigger ?? '';
      const name = button.dataset.areaName ?? '';
      activateArea(slug, name);
    });
  });

  const currentAreaSlug = menuTabs.dataset.currentArea ?? '';
  if (currentAreaSlug) {
    const initial = areaButtons.find((button) => button.dataset.areaTrigger === currentAreaSlug);
    if (initial) {
      activateArea(initial.dataset.areaTrigger ?? '', initial.dataset.areaName ?? '');
    }
  }

  updateMenuTabHeight();
  window.addEventListener('resize', updateMenuTabHeight, { passive: true });

  if (typeof ResizeObserver !== 'undefined') {
    const observer = new ResizeObserver(updateMenuTabHeight);
    observer.observe(menuTabs);
  }
</script>

<style>
  .site-menu-tabs {
    position: sticky;
    top: var(--site-menu-tabs-top, 8px);
    z-index: 40;
    margin-bottom: 14px;
    padding: 10px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(6, 8, 13, 0.86);
    backdrop-filter: blur(8px);
    display: grid;
    gap: 8px;
  }

  .menu-top-row {
    display: flex;
    justify-content: flex-end;
  }

  .menu-toggle {
    min-height: 38px;
    min-width: 76px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.08);
    color: #f2f6ff;
    font-size: 0.92rem;
    cursor: pointer;
  }

  .menu-panel {
    display: grid;
    gap: 10px;
    padding: 6px 2px 2px;
  }

  .menu-section-title {
    margin: 0;
    color: #f2f6ff;
    font-size: 0.86rem;
    opacity: 0.78;
  }

  .menu-region-list {
    display: grid;
    gap: 8px;
  }

  .menu-region-list a,
  .menu-region-list button,
  .category-panel a {
    width: 100%;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0 14px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #f2f6ff;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.04);
    font-size: 1rem;
  }

  .menu-region-list button {
    cursor: pointer;
  }

  .menu-region-list a.active,
  .menu-region-list button.active {
    border-color: rgba(255, 52, 174, 0.86);
    background: rgba(255, 52, 174, 0.2);
    color: #ffffff;
  }

  .menu-category-wrap {
    display: grid;
    gap: 8px;
  }

  .category-panel {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .category-panel[hidden] {
    display: none;
  }

  .category-panel li {
    margin: 0;
    padding: 0;
  }

  .category-panel a.active {
    border-color: rgba(34, 244, 255, 0.8);
    background: rgba(34, 244, 255, 0.16);
  }
</style>
