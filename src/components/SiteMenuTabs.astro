---
import { getCollection } from 'astro:content';

const [areasRaw, categoriesRaw, venuesRaw] = await Promise.all([
  getCollection('areas'),
  getCollection('categories'),
  getCollection('venues'),
]);

const areas = areasRaw.sort((a, b) => a.data.order - b.data.order);
const categories = categoriesRaw.sort((a, b) => a.data.order - b.data.order);
const visibleVenues = venuesRaw.filter((venue) => venue.data.visible);

const normalizePath = (value) => {
  if (!value) return '/';
  return value.endsWith('/') ? value : `${value}/`;
};

const pathname = normalizePath(Astro.url.pathname);

const isExactActive = (href) => pathname === normalizePath(href);
const isCategoryActive = (areaSlug, categorySlug) => pathname.startsWith(`/${areaSlug}/${categorySlug}/`);

const currentAreaSlug = areas.find((area) => pathname.startsWith(`/${area.slug}/`))?.slug;
const defaultAreaSlug = currentAreaSlug ?? '';

const areaCategoryMap = areas.reduce((acc, area) => {
  const availableCategorySlugs = new Set(
    visibleVenues.filter((venue) => venue.data.area === area.slug).map((venue) => venue.data.category),
  );

  acc[area.slug] = categories.filter((category) => availableCategorySlugs.has(category.slug));
  return acc;
}, {});
---

<nav class="site-menu-tabs" data-site-menu-tabs aria-label="사이트 메뉴">
  <div class="menu-group menu-home-area">
    <a class:list={{ active: isExactActive('/') }} href="/">홈</a>
    {areas.map((area) => (
      <button
        type="button"
        class:list={{ active: area.slug === defaultAreaSlug }}
        data-area-trigger={area.slug}
        aria-pressed={area.slug === defaultAreaSlug ? 'true' : 'false'}
      >
        {area.data.name}
      </button>
    ))}
  </div>

  <div class="menu-category" data-area-panels hidden={!defaultAreaSlug}>
    {areas.map((area) => (
      <ul class="category-panel" data-area-panel={area.slug} hidden={area.slug !== defaultAreaSlug}>
        {areaCategoryMap[area.slug].map((category) => (
          <li>
            <a
              class:list={{ active: isCategoryActive(area.slug, category.slug) }}
              href={`/${area.slug}/${category.slug}/`}
            >
              {category.data.name}
            </a>
          </li>
        ))}
      </ul>
    ))}
  </div>
</nav>

<script type="module">
  const menuTabs = document.querySelector('[data-site-menu-tabs]');
  const root = document.documentElement;
  const areaButtons = Array.from(document.querySelectorAll('[data-area-trigger]'));
  const areaPanels = Array.from(document.querySelectorAll('[data-area-panel]'));

  if (menuTabs) {
    const categoryPanels = menuTabs.querySelector('[data-area-panels]');

    const activateArea = (areaSlug) => {
      areaButtons.forEach((button) => {
        const isActive = button.dataset.areaTrigger === areaSlug;
        button.classList.toggle('active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      if (categoryPanels) {
        categoryPanels.hidden = !areaSlug;
      }

      areaPanels.forEach((panel) => {
        panel.hidden = panel.dataset.areaPanel !== areaSlug;
      });
    };

    areaButtons.forEach((button) => {
      button.addEventListener('click', () => activateArea(button.dataset.areaTrigger));
    });

    const updateMenuTabHeight = () => {
      const height = Math.ceil(menuTabs.getBoundingClientRect().height);
      root.style.setProperty('--site-menu-tabs-height', `${height}px`);
    };

    updateMenuTabHeight();
    window.addEventListener('resize', updateMenuTabHeight, { passive: true });

    if (typeof ResizeObserver !== 'undefined') {
      const observer = new ResizeObserver(updateMenuTabHeight);
      observer.observe(menuTabs);
    }
  }
</script>

<style>
  .site-menu-tabs {
    position: sticky;
    top: var(--site-menu-tabs-top, 8px);
    z-index: 40;
    margin-bottom: 14px;
    padding: 10px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(6, 8, 13, 0.86);
    backdrop-filter: blur(8px);
    display: grid;
    gap: 8px;
  }

  .menu-group {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .menu-group::-webkit-scrollbar {
    display: none;
  }

  .menu-group a,
  .menu-group button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #f2f6ff;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .menu-group button {
    cursor: pointer;
  }

  .menu-group a.active,
  .menu-group button.active {
    border-color: rgba(255, 52, 174, 0.86);
    background: rgba(255, 52, 174, 0.2);
    color: #ffffff;
  }

  .menu-category {
    overflow: hidden;
  }

  .category-panel {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .category-panel li {
    margin: 0;
    padding: 0;
  }

  .category-panel a {
    width: 100%;
    min-height: 40px;
    justify-content: flex-start;
    padding: 0 14px;
    border-radius: 10px;
  }

  .menu-category a.active {
    border-color: rgba(34, 244, 255, 0.8);
    background: rgba(34, 244, 255, 0.16);
  }
</style>
