---
import BaseLayout from '../layouts/BaseLayout.astro';
import BannerSlot from '../components/BannerSlot.astro';
import JsonLd from '../components/JsonLd.astro';
import { getCollection } from 'astro:content';

const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);
const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const venues = (await getCollection('venues')).filter((v) => v.data.visible).sort((a, b) => a.data.order - b.data.order);
const homeEntries = await getCollection('home');

const defaultHero = {
  heroKicker: 'THAILAND NIGHT GUIDE',
  heroTitle: '방콕 · 파타야 · 치앙마이 프리미엄 나이트라이프 가이드',
  heroDescription:
    'Thai Bam은 태국 주요 지역의 KTV, 스파, 클럽 예약, VIP 가이드 정보를 정적 페이지로 정리한 디렉토리입니다. 지역 페이지, 카테고리 페이지, 업체 상세 페이지를 내부 링크로 연결해 빠른 탐색과 문의 전환에 최적화했습니다.',
};
const resolveVenueSlug = (entry) => entry.data.slug?.trim() || entry.slug;

const homeHero = homeEntries.find((entry) => entry.slug === 'home-hero')?.data ?? homeEntries[0]?.data ?? defaultHero;
const POST_INITIAL_COUNT = 5;
const POST_BATCH_SIZE = 5;

const latestVenues = [...venues].sort((a, b) => new Date(b.data.updatedAt).getTime() - new Date(a.data.updatedAt).getTime());
const featuredVenues = venues.filter((v) => v.data.featured).slice(0, 4);
const heroVenues = featuredVenues.length > 0 ? featuredVenues : latestVenues.slice(0, 4);
const autoCategoryHighlights = categories
  .map((category) => {
    const sample = latestVenues.find((venue) => venue.data.category === category.slug);
    return sample ? { category, sample } : null;
  })
  .filter(Boolean);

const configuredCategoryHighlights = (homeHero.categoryHighlights ?? [])
  .map((item) => {
    const category = categories.find((entry) => entry.slug === item.category);
    const sample = latestVenues.find((entry) => resolveVenueSlug(entry) === item.venueSlug);
    return category && sample ? { category, sample } : null;
  })
  .filter(Boolean);

const categoryHighlights = configuredCategoryHighlights.length > 0 ? configuredCategoryHighlights : autoCategoryHighlights;

const defaultFaqItems = [
  {
    q: '방콕, 파타야, 치앙마이 중 어디부터 보는 게 좋나요?',
    a: '일정이 가장 긴 지역부터 확인한 뒤, 카테고리별 상세 페이지로 이동하면 동선과 문의 흐름을 빠르게 정리할 수 있습니다.',
  },
  {
    q: '업체 상세 페이지에서 무엇을 먼저 확인해야 하나요?',
    a: '영업시간, 가격대, 위치 안내, 문의 버튼 순서로 확인하면 이용 전 핵심 정보를 빠르게 파악할 수 있습니다.',
  },
  {
    q: '문의 링크가 아직 없는 경우도 있나요?',
    a: '네. 운영 중인 채널만 우선 노출하며, 준비 중인 채널은 순차적으로 업데이트됩니다.',
  },
];

const faqItems = homeHero.faqItems?.length
  ? homeHero.faqItems.map((item) => ({ q: item.question, a: item.answer }))
  : defaultFaqItems;

const seoBlockTitle = homeHero.seoBlockTitle ?? '태국 지역별 KTV, 스파, 클럽, VIP 가이드 정보';
const seoBlockParagraph1 =
  homeHero.seoBlockParagraph1 ??
  '메인 랜딩은 지역 페이지와 카테고리 페이지를 동시에 안내하며, 각 업체 상세 페이지는 단일 정규 URL로 연결합니다. 중복 URL을 최소화하고, title/description/canonical/내부 링크 구조를 유지해 검색엔진이 페이지 주제를 정확히 이해하도록 구성했습니다.';
const seoBlockParagraph2 =
  homeHero.seoBlockParagraph2 ??
  '신규 등록 업체는 최신 등록 영역과 카테고리 대표 글 영역에 반영되어 탐색 경로를 단순화합니다. 이용자는 지역 → 카테고리 → 업체 상세 순서로 이동하면서 영업시간, 가격대, 문의 채널을 빠르게 확인할 수 있습니다.';
const areaSectionTitle = homeHero.areaSectionTitle ?? '지역별 탐색';
const areaSectionDescription =
  homeHero.areaSectionDescription ?? '지역별 대표 글과 지역 소개를 확인하고 원하는 지역 페이지로 바로 이동할 수 있습니다.';
const areaSectionCollapsed = homeHero.areaSectionCollapsed ?? true;

const autoAreaCards = areas.map((area) => ({
  area,
  areaVenues: venues.filter((venue) => venue.data.area === area.slug).slice(0, 3),
}));

const configuredAreaCards = (homeHero.areaExplorerAreas ?? [])
  .map((item) => {
    const area = areas.find((entry) => entry.slug === item.area);
    if (!area) return null;
    const manualVenues = (item.venueSlugs ?? [])
      .map((slug) => venues.find((entry) => resolveVenueSlug(entry) === slug))
      .filter(Boolean);
    return {
      area,
      areaVenues: manualVenues.length > 0 ? manualVenues : venues.filter((venue) => venue.data.area === area.slug).slice(0, 3),
    };
  })
  .filter(Boolean);

const areaCards = configuredAreaCards.length > 0 ? configuredAreaCards : autoAreaCards;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Thai Bam',
  url: new URL('/', Astro.site).toString(),
  inLanguage: 'ko',
};

const formatDate = (value) => {
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '';
  return new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
};

const getThumbPosition = (position) => {
  if (position === 'top') return 'center top';
  if (position === 'bottom') return 'center bottom';
  return 'center center';
};
---

<BaseLayout title="태국 KTV·스파·클럽 예약 정보 | Thai Bam" description="방콕, 파타야, 치앙마이 지역의 KTV, 스파, 클럽 예약 및 VIP 가이드 정보를 빠르게 확인하고 문의까지 연결할 수 있습니다.">
  <JsonLd data={jsonLd} />

  <div class="home-page">
    <section class="home-hero reveal">
      <p class="hero-kicker">{homeHero.heroKicker}</p>
      <h1>{homeHero.heroTitle}</h1>
      <p class="hero-copy">{homeHero.heroDescription}</p>

      <div class="hero-actions">
        <a href="/bangkok/">방콕 보기</a>
        <a href="/pattaya/">파타야 보기</a>
        <a href="/chiang-mai/">치앙마이 보기</a>
      </div>

      <BannerSlot position="home_hero" />

      <div class="hero-cards">
        {heroVenues.map((venue) => (
          <a class="hero-card" href={`/venue/${resolveVenueSlug(venue)}/`}>
            <img
              src={venue.data.thumbnail}
              alt={venue.data.thumbnailAlt}
              width="640"
              height="380"
              loading="lazy"
              style={`object-position:${getThumbPosition(venue.data.thumbnailPosition)};`}
            />
            <div>
              <strong>{venue.data.title}</strong>
              <p>{venue.data.shortDescription}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <BannerSlot position="home_top" />

    <section class="section-strip reveal">
      <h2>게시물</h2>
    </section>

    <section class="post-feed reveal">
      <div class="post-feed-head">
        <h2>All Posts</h2>
        <span>{latestVenues.length} entries</span>
      </div>

      <div class="post-grid">
        {latestVenues.map((venue, index) => (
          <article class="post-card" data-post-item hidden={index >= POST_INITIAL_COUNT}>
            <a href={`/venue/${resolveVenueSlug(venue)}/`}>
              <img
                src={venue.data.thumbnail}
                alt={venue.data.thumbnailAlt}
                width="1200"
                height="700"
                loading="lazy"
                style={`object-position:${getThumbPosition(venue.data.thumbnailPosition)};`}
              />
              <div class="post-body">
                <p class="post-meta">
                  {formatDate(venue.data.updatedAt)} · {venue.data.area} · {venue.data.category}
                </p>
                <h3>{venue.data.title}</h3>
                <p>{venue.data.shortDescription}</p>
              </div>
            </a>
          </article>
        ))}
      </div>

      {latestVenues.length > POST_INITIAL_COUNT && (
        <div class="post-more-wrap">
          <button type="button" class="post-more-button" data-post-more data-batch-size={POST_BATCH_SIZE}>더보기</button>
        </div>
      )}
    </section>

    <section class="quick-links reveal">
      <h2>카테고리 바로가기</h2>
      <div class="chip-grid">
        {categories.map((category) => (
          <a href={`/${category.slug}/`}>{category.data.name}</a>
        ))}
      </div>
    </section>

    <section class="area-grid reveal">
      <div class="area-grid-head">
        <div>
          <h2>{areaSectionTitle}</h2>
          <p>{areaSectionDescription}</p>
        </div>
        <button
          type="button"
          class="area-grid-toggle"
          data-area-toggle
          aria-expanded={areaSectionCollapsed ? 'false' : 'true'}
          aria-controls="area-grid-content"
        >
          <span>{areaSectionCollapsed ? '펼치기' : '접기'}</span>
        </button>
      </div>
      <div class="area-grid-content" id="area-grid-content" data-area-content hidden={areaSectionCollapsed}>
        <div class="area-cards">
          {areaCards.map(({ area, areaVenues }) => (
            <article class="area-card">
              <h3>{area.data.name}</h3>
              <p>{area.data.intro}</p>
              <div class="area-links">
                <a href={`/${area.slug}/`}>지역 페이지</a>
                {areaVenues.map((venue) => (
                  <a href={`/venue/${resolveVenueSlug(venue)}/`}>{venue.data.title}</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <BannerSlot position="home_middle" />

    <section class="category-showcase reveal">
      <h2>카테고리 대표 글</h2>
      <div class="category-list">
        {categoryHighlights.map((item) => (
          <a class="category-item" href={`/venue/${resolveVenueSlug(item.sample)}/`}>
            <img
              src={item.sample.data.thumbnail}
              alt={item.sample.data.thumbnailAlt}
              width="900"
              height="560"
              loading="lazy"
              style={`object-position:${getThumbPosition(item.sample.data.thumbnailPosition)};`}
            />
            <div>
              <p>{item.category.data.name}</p>
              <h3>{item.sample.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="seo-copy reveal">
      <h2>{seoBlockTitle}</h2>
      <p>{seoBlockParagraph1}</p>
      <p>{seoBlockParagraph2}</p>
    </section>

    <section class="faq reveal">
      <h2>자주 묻는 질문</h2>
      <div class="faq-grid">
        {faqItems.map((item) => (
          <article>
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script type="module">
    const postItems = Array.from(document.querySelectorAll('[data-post-item]'));
    const postMoreButton = document.querySelector('[data-post-more]');
    const postBatchSize = Number(postMoreButton?.getAttribute('data-batch-size') || 5);
    let visiblePostCount = Math.min(5, postItems.length);

    const updatePosts = () => {
      postItems.forEach((item, index) => {
        item.hidden = index >= visiblePostCount;
      });

      if (!postMoreButton) return;
      const remaining = Math.max(postItems.length - visiblePostCount, 0);
      if (remaining <= 0) {
        postMoreButton.hidden = true;
        return;
      }
      postMoreButton.hidden = false;
      postMoreButton.textContent = `더보기 (${Math.min(postBatchSize, remaining)}개)`;
    };

    updatePosts();
    postMoreButton?.addEventListener('click', () => {
      visiblePostCount = Math.min(visiblePostCount + postBatchSize, postItems.length);
      updatePosts();
    });

    const areaToggleButton = document.querySelector('[data-area-toggle]');
    const areaContent = document.querySelector('[data-area-content]');
    const updateAreaToggleText = (isExpanded) => {
      const label = areaToggleButton?.querySelector('span');
      if (label) label.textContent = isExpanded ? '접기' : '펼치기';
    };

    areaToggleButton?.addEventListener('click', () => {
      if (!areaContent) return;
      const isExpanded = areaToggleButton.getAttribute('aria-expanded') === 'true';
      const nextExpanded = !isExpanded;
      areaToggleButton.setAttribute('aria-expanded', nextExpanded ? 'true' : 'false');
      areaContent.hidden = !nextExpanded;
      updateAreaToggleText(nextExpanded);
    });

    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14 }
    );

    reveals.forEach((item) => observer.observe(item));
  </script>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;800&family=Saira+Semi+Condensed:wght@400;600;700;800&display=swap');

  :global(body) {
    margin: 0;
    color: #f7f7f7;
    background:
      radial-gradient(1200px 500px at 10% -10%, rgba(255, 0, 128, 0.24), transparent 60%),
      radial-gradient(1000px 420px at 90% -20%, rgba(0, 255, 224, 0.18), transparent 62%),
      #050507;
    font-family: 'Saira Semi Condensed', 'Noto Sans KR', sans-serif;
  }

  :global(main) {
    max-width: 1180px;
    margin: 0 auto;
    padding: 14px 14px 84px;
  }

  .home-page {
    display: grid;
    gap: 16px;
  }

  .home-hero {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 22px;
    padding: 20px;
    background:
      linear-gradient(165deg, rgba(0, 0, 0, 0.85) 0%, rgba(13, 13, 17, 0.95) 45%, rgba(24, 24, 30, 0.92) 100%);
  }

  .home-hero::before {
    content: '';
    position: absolute;
    inset: -35% auto auto -30%;
    width: 420px;
    height: 420px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(255, 0, 145, 0.35) 0%, rgba(255, 0, 145, 0) 70%);
    pointer-events: none;
  }

  .home-hero::after {
    content: '';
    position: absolute;
    inset: auto -20% -40% auto;
    width: 420px;
    height: 420px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(0, 255, 238, 0.25) 0%, rgba(0, 255, 238, 0) 68%);
    pointer-events: none;
  }

  .hero-kicker {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #ffe600;
  }

  .home-hero h1 {
    margin: 8px 0 10px;
    font-size: clamp(1.7rem, 5.4vw, 2.9rem);
    line-height: 1.14;
    color: #ff3fb2;
    text-wrap: balance;
  }

  .hero-copy {
    margin: 0;
    max-width: 820px;
    line-height: 1.72;
    font-size: 1rem;
    color: #e6e9f2;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .hero-actions a {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 42px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #f8fbff;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.06);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .hero-actions a:hover {
    transform: translateY(-1px);
    border-color: #67faff;
  }

  .hero-cards {
    margin-top: 18px;
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .hero-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: #0d0e13;
  }

  .hero-card img {
    width: 100%;
    height: 138px;
    object-fit: cover;
    display: block;
  }

  .hero-card div {
    padding: 10px;
  }

  .hero-card strong {
    display: block;
    color: #ffe600;
    font-size: 0.95rem;
  }

  .hero-card p {
    margin: 5px 0 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: #d6d9e3;
  }

  .section-strip {
    padding: 12px 14px;
    border-radius: 12px;
    background: #00ebff;
    color: #031018;
  }

  .section-strip h2 {
    margin: 0;
    font-size: 1.5rem;
    letter-spacing: 0.01em;
  }

  .post-feed {
    padding: 16px;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(5, 6, 8, 0.9);
  }

  .post-feed-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }

  .post-feed-head h2 {
    margin: 0;
    font-size: 2rem;
    color: #f8f8f8;
  }

  .post-feed-head span {
    color: #a8afc0;
    font-size: 0.9rem;
  }

  .post-grid {
    margin-top: 12px;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  }

  .post-more-wrap {
    margin-top: 14px;
    display: flex;
    justify-content: center;
  }

  .post-more-button {
    min-height: 42px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.07);
    color: #f5f8ff;
    font-weight: 700;
    cursor: pointer;
  }

  .post-card {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #090a0f;
  }

  .post-card a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-card img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    display: block;
  }

  .post-body {
    padding: 12px;
  }

  .post-meta {
    margin: 0;
    color: #9ca5ba;
    font-size: 0.8rem;
  }

  .post-body h3 {
    margin: 7px 0 8px;
    font-size: 1.28rem;
    line-height: 1.32;
    color: #ff2ea5;
  }

  .post-body p {
    margin: 0;
    line-height: 1.6;
    color: #e0e5f2;
  }

  .quick-links,
  .area-grid,
  .category-showcase,
  .seo-copy,
  .faq {
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 18px;
    background: rgba(8, 9, 12, 0.9);
  }

  .quick-links h2,
  .category-showcase h2,
  .seo-copy h2,
  .faq h2 {
    margin: 0 0 12px;
    font-size: 1.4rem;
    color: #ffe600;
  }

  .area-grid-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .area-grid h2 {
    margin: 0;
    font-size: 1.4rem;
    color: #ffe600;
  }

  .area-grid-head p {
    margin: 8px 0 0;
    color: #d3d9e8;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .area-grid-toggle {
    flex-shrink: 0;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.06);
    color: #f5f8ff;
    font-weight: 700;
    cursor: pointer;
  }

  .area-grid-content {
    margin-top: 14px;
  }

  .chip-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip-grid a {
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    padding: 9px 12px;
    text-decoration: none;
    color: #eef3ff;
    background: rgba(255, 255, 255, 0.06);
  }

  .area-cards {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .area-card {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    padding: 12px;
    background: #090a10;
  }

  .area-card h3 {
    margin: 0;
    color: #ff46b6;
    font-size: 1.25rem;
  }

  .area-card p {
    margin: 8px 0 10px;
    color: #dde3f1;
    line-height: 1.65;
  }

  .area-links {
    display: grid;
    gap: 6px;
  }

