---
import BaseLayout from '../layouts/BaseLayout.astro';
import BannerSlot from '../components/BannerSlot.astro';
import JsonLd from '../components/JsonLd.astro';
import { getCollection } from 'astro:content';

const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);
const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const venues = (await getCollection('venues')).filter((v) => v.data.visible).sort((a, b) => a.data.order - b.data.order);

const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: '브랜드명', url: new URL('/', Astro.site).toString(), inLanguage: 'ko' };
---
<BaseLayout title="태국 KTV·스파·클럽 예약 정보 | 브랜드명" description="방콕, 파타야, 푸켓 지역의 KTV, 스파, 클럽 예약 및 VIP 가이드 정보를 한곳에서 확인하세요.">
  <JsonLd data={jsonLd} />
  <h1>태국 지역별 KTV, 스파, 클럽, VIP 가이드 정보</h1>
  <p>방콕, 파타야, 푸켓 지역에서 찾을 수 있는 KTV, 스파, 클럽 예약, VIP 가이드 정보를 한눈에 확인할 수 있도록 정리했습니다.</p>
  <BannerSlot position="home_top" />
  <h2>주요 지역</h2><div class="grid">{areas.map((area) => <a class="card" href={`/${area.slug}/`}>{area.data.name}</a>)}</div>
  <h2>주요 카테고리</h2><div class="grid">{categories.map((c) => <a class="card" href={`/${c.slug}/`}>{c.data.name}</a>)}</div>
  <BannerSlot position="home_middle" />
  <h2>추천 업체</h2><div class="grid">{venues.slice(0, 6).map((v) => <a class="card" href={`/venue/${v.slug}/`}>{v.data.title}</a>)}</div>
</BaseLayout>
