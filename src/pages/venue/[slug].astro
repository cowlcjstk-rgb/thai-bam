---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import BannerSlot from '../../components/BannerSlot.astro';
import ContactInquiryBanner from '../../components/ContactInquiryBanner.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const venues = await getCollection('venues');
  const resolveVenueSlug = (entry) => entry.data.slug?.trim() || entry.slug;
  return venues
    .filter((entry) => entry.data.visible)
    .map((venue) => ({ params: { slug: resolveVenueSlug(venue) }, props: { venue } }));
}

const { venue } = Astro.props;
const venueSlug = venue.data.slug?.trim() || venue.slug;
const [areas, categories, venues] = await Promise.all([
  getCollection('areas'),
  getCollection('categories'),
  getCollection('venues'),
]);

const area = areas.find((a) => a.slug === venue.data.area);
const category = categories.find((c) => c.slug === venue.data.category);

const related = venues
  .filter((entry) => entry.data.visible && (entry.data.slug?.trim() || entry.slug) !== venueSlug && entry.data.area === venue.data.area)
  .slice(0, 6);

const fallbackSteps = [
  { title: '문의 접수', detail: '카카오톡 또는 라인으로 원하는 날짜와 시간대를 먼저 전달해 주세요.' },
  { title: '이용 안내 확인', detail: '가능 시간, 위치, 기본 이용 가이드를 확인한 뒤 진행 여부를 결정합니다.' },
  { title: '방문 및 이용', detail: '안내된 시간에 방문하여 현장에서 최종 확인 후 이용을 시작합니다.' },
];

const timelineSteps = venue.data.usageSteps.length > 0 ? venue.data.usageSteps : fallbackSteps;
const getThumbPosition = (position) => {
  if (position === 'top') return 'center top';
  if (position === 'bottom') return 'center bottom';
  return 'center center';
};
const heroImagePosition = getThumbPosition(venue.data.thumbnailPosition);
const priceText = venue.data.priceRange?.trim() ?? '';
const normalizedPriceText = priceText.replace(/\\n/g, '\n');
const priceFallback = '문의 후 안내';
const priceLines = normalizedPriceText
  ? normalizedPriceText
      .split(/\r?\n/)
      .map((line) => line.trim())
      .filter(Boolean)
  : [];
const hasLongPriceText = priceLines.length >= 2;
const priceSummary = normalizedPriceText || priceFallback;

const extractCoords = (raw) => {
  if (!raw) return undefined;

  const markerMatches = [...raw.matchAll(/!3d(-?\d+(?:\.\d+)?)!4d(-?\d+(?:\.\d+)?)/g)];
  if (markerMatches.length > 0) {
    const last = markerMatches[markerMatches.length - 1];
    return { lat: Number(last[1]), lng: Number(last[2]) };
  }

  const twoDThreeDMatches = [...raw.matchAll(/!2d(-?\d+(?:\.\d+)?)!3d(-?\d+(?:\.\d+)?)/g)];
  if (twoDThreeDMatches.length > 0) {
    const last = twoDThreeDMatches[twoDThreeDMatches.length - 1];
    return { lat: Number(last[2]), lng: Number(last[1]) };
  }

  const atMatch = raw.match(/@(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/);
  if (atMatch) return { lat: Number(atMatch[1]), lng: Number(atMatch[2]) };

  const strictPairMatch = raw.match(/^\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*$/);
  if (strictPairMatch) return { lat: Number(strictPairMatch[1]), lng: Number(strictPairMatch[2]) };

  return undefined;
};

const isValidLat = (value) => Number.isFinite(value) && Math.abs(value) <= 90;
const isValidLng = (value) => Number.isFinite(value) && Math.abs(value) <= 180;
const toMapEmbedByCoords = (lat, lng) => `https://www.google.com/maps?q=${lat},${lng}&z=16&output=embed`;

const resolveMapData = async (mapUrl, latitude, longitude) => {
  if (typeof latitude === 'number' && typeof longitude === 'number') {
    return {
      externalUrl: mapUrl || `https://maps.google.com/?q=${latitude},${longitude}`,
      embedUrl: toMapEmbedByCoords(latitude, longitude),
    };
  }

  const originalUrl = mapUrl?.trim();
  if (!originalUrl) return { externalUrl: undefined, embedUrl: undefined };

  let resolvedUrl = originalUrl;

  try {
    const parsed = new URL(originalUrl);
    const isShortMapUrl =
      parsed.hostname === 'maps.app.goo.gl' ||
      parsed.hostname === 'goo.gl' ||
      parsed.hostname.endsWith('.goo.gl');

    if (isShortMapUrl) {
      const response = await fetch(originalUrl, { method: 'GET', redirect: 'follow' });
      if (response?.url) resolvedUrl = response.url;
    }

    if (parsed.hostname.includes('google.') && parsed.pathname.includes('/maps/embed')) {
      return { externalUrl: originalUrl, embedUrl: originalUrl };
    }
  } catch {
    // no-op
  }

  const coords = extractCoords(resolvedUrl) ?? extractCoords(originalUrl);
  if (coords && isValidLat(coords.lat) && isValidLng(coords.lng)) {
    return {
      externalUrl: originalUrl,
      embedUrl: toMapEmbedByCoords(coords.lat, coords.lng),
    };
  }

  try {
    const parsed = new URL(resolvedUrl);
    const queryParams = ['q', 'query', 'll', 'center', 'destination', 'origin'];
    const query = queryParams.map((key) => parsed.searchParams.get(key)).find(Boolean);
    if (query) {
      const queryCoords = extractCoords(query);
      if (queryCoords && isValidLat(queryCoords.lat) && isValidLng(queryCoords.lng)) {
        return {
          externalUrl: originalUrl,
          embedUrl: toMapEmbedByCoords(queryCoords.lat, queryCoords.lng),
        };
      }

      return {
        externalUrl: originalUrl,
        embedUrl: `https://www.google.com/maps?q=${encodeURIComponent(query)}&output=embed`,
      };
    }
  } catch {
    // no-op
  }

  return {
    externalUrl: originalUrl,
    embedUrl: `https://www.google.com/maps?q=${encodeURIComponent(resolvedUrl)}&output=embed`,
  };
};

const { externalUrl: mapExternalUrl, embedUrl: mapEmbedUrl } = await resolveMapData(
  venue.data.googleMapUrl,
  venue.data.latitude,
  venue.data.longitude
);

const dedupe = new Set();
const galleryItems = [
  { image: venue.data.thumbnail, alt: venue.data.thumbnailAlt },
  ...venue.data.gallery,
].filter((item) => {
  if (dedupe.has(item.image)) return false;
  dedupe.add(item.image);
  return true;
});

const { Content } = await venue.render();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: venue.data.title,
  description: venue.data.shortDescription,
  image: [new URL(venue.data.thumbnail, Astro.site).toString()],
  url: new URL(`/venue/${venueSlug}/`, Astro.site).toString(),
  address: {
    '@type': 'PostalAddress',
    addressLocality: area?.data.name ?? venue.data.area,
    addressCountry: 'TH',
  },
  priceRange: venue.data.priceRange || '$$',
};
---

<BaseLayout title={venue.data.seoTitle} description={venue.data.seoDescription}>
  <JsonLd data={jsonLd} />

  <section class="venue-hero reveal">
    <img src={venue.data.thumbnail} alt={venue.data.thumbnailAlt} width="1400" height="820" loading="eager" style={`object-position:${heroImagePosition};`} />
    <div class="hero-overlay">
      <p>{area?.data.name ?? venue.data.area} · {category?.data.name ?? venue.data.category}</p>
      <h1>{venue.data.title}</h1>
      <p class="hero-lead">{venue.data.shortDescription}</p>
    </div>
  </section>

  <section class="venue-core-sticky reveal" data-core-sticky>
    <div class="core-card">
      <span>지역</span>
      <strong>{area?.data.name ?? venue.data.area}</strong>
    </div>
    <div class="core-card">
      <span>영업시간</span>
      <strong>{venue.data.openingHours ?? '문의 시 안내'}</strong>
    </div>
    <div class="core-card">
      <span>가격대</span>
      <strong class:list={['price-summary', hasLongPriceText && 'is-collapsible']} data-price-summary>{priceSummary}</strong>
      {hasLongPriceText && (
        <button type="button" class="price-toggle" data-price-toggle aria-expanded="true">
          접기
        </button>
      )}
    </div>
  </section>

  <BannerSlot position="venue_top" />

  <section class="venue-grid">
    <div class="venue-main">
      <section class="section-block reveal">
        <h2>갤러리</h2>
        <div class="gallery-shell">
          <button class="gallery-nav" data-gallery-prev type="button" aria-label="이전 이미지">‹</button>

          <div class="gallery-track" data-gallery-track>
            {galleryItems.map((item, index) => (
              <button class="gallery-slide" data-gallery-slide type="button" data-lightbox-open={index}>
                <img
                  src={item.image}
                  alt={item.alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  width="1200"
                  height="700"
                  style={`object-position:${index === 0 ? heroImagePosition : 'center center'};`}
                />
              </button>
            ))}
          </div>

          <button class="gallery-nav" data-gallery-next type="button" aria-label="다음 이미지">›</button>
        </div>

        <div class="gallery-dots">
          {galleryItems.map((_, index) => (
            <button type="button" class="gallery-dot" data-gallery-dot={index} aria-label={`이미지 ${index + 1}`}></button>
          ))}
        </div>
      </section>

      <section id="venue-inquiry" class="section-block reveal">
        <h2>상세 안내</h2>
        {venue.data.introBody && <p class="intro-body">{venue.data.introBody}</p>}
        {normalizedPriceText && (
          <div class="price-box">
            <h3>가격대 안내</h3>
            <p>{normalizedPriceText}</p>
          </div>
        )}
        <p class="location-text">{venue.data.addressText ?? '위치 상세 안내는 문의 시 전달됩니다.'}</p>
        <article class="venue-body">
          <Content />
        </article>
        {venue.data.bodyImages?.length > 0 && (
          <div class="body-image-grid">
            {venue.data.bodyImages.map((item) => (
              <figure class="body-image-item">
                <img src={item.image} alt={item.alt} loading="lazy" width="1200" height="700" />
                {item.alt && <figcaption>{item.alt}</figcaption>}
              </figure>
            ))}
          </div>
        )}
        {mapEmbedUrl && (
          <div class="map-embed">
            <iframe
              title={`${venue.data.title} 위치`}
              src={mapEmbedUrl}
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        )}
        {mapExternalUrl && (
          <p class="map-link-wrap">
            <a class="map-link" href={mapExternalUrl} target="_blank" rel="noopener noreferrer nofollow">구글맵 위치 보기</a>
          </p>
        )}
      </section>

      <section class="section-block reveal">
        <h2>이용 순서</h2>
        <ol class="timeline">
          {timelineSteps.map((step, index) => (
            <li class="timeline-item">
              <span class="timeline-index">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <ContactInquiryBanner kakaoUrl={venue.data.kakaoUrl} lineUrl={venue.data.lineUrl} inquiryHref="#venue-inquiry" />
    </div>
  </section>

  <section class="section-block reveal">
    <h2>관련 게시물</h2>
    <div class="related-grid">
      {related.map((item) => (
        <a class="related-card reveal" href={`/venue/${item.data.slug?.trim() || item.slug}/`}>
          <img
            src={item.data.thumbnail}
            alt={item.data.thumbnailAlt}
            loading="lazy"
            width="600"
            height="360"
            style={`object-position:${getThumbPosition(item.data.thumbnailPosition)};`}
          />
          <div>
            <h3>{item.data.title}</h3>
            <p>{item.data.shortDescription}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <BannerSlot position="venue_bottom" />

  <script id="gallery-json" type="application/json" set:html={JSON.stringify(galleryItems)}></script>

  <div class="lightbox" data-lightbox hidden>
    <button class="lightbox-close" type="button" data-lightbox-close aria-label="닫기">✕</button>
    <button class="lightbox-nav" type="button" data-lightbox-prev aria-label="이전">‹</button>
    <figure>
      <img data-lightbox-image src="" alt="" />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
    <button class="lightbox-nav" type="button" data-lightbox-next aria-label="다음">›</button>
  </div>

  <script type="module">
    const track = document.querySelector('[data-gallery-track]');
    const prevButton = document.querySelector('[data-gallery-prev]');
    const nextButton = document.querySelector('[data-gallery-next]');
    const dotButtons = Array.from(document.querySelectorAll('[data-gallery-dot]'));

    const syncDots = () => {
      if (!track || dotButtons.length === 0) return;
      const index = Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
      dotButtons.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
    };

    if (track) {
      syncDots();
      prevButton?.addEventListener('click', () => {
        track.scrollBy({ left: -track.clientWidth, behavior: 'smooth' });
      });
      nextButton?.addEventListener('click', () => {
        track.scrollBy({ left: track.clientWidth, behavior: 'smooth' });
      });
      track.addEventListener('scroll', syncDots, { passive: true });
      dotButtons.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
        });
      });
    }

    const lightbox = document.querySelector('[data-lightbox]');
    const lbImage = document.querySelector('[data-lightbox-image]');
    const lbCaption = document.querySelector('[data-lightbox-caption]');
    const openButtons = Array.from(document.querySelectorAll('[data-lightbox-open]'));
    const closeButton = document.querySelector('[data-lightbox-close]');
    const prevLightboxButton = document.querySelector('[data-lightbox-prev]');
    const nextLightboxButton = document.querySelector('[data-lightbox-next]');
    const galleryData = JSON.parse(document.querySelector('#gallery-json')?.textContent || '[]');

    let activeIndex = 0;

    const renderLightbox = () => {
      if (!galleryData[activeIndex] || !lbImage || !lbCaption) return;
      lbImage.src = galleryData[activeIndex].image;
      lbImage.alt = galleryData[activeIndex].alt;
      lbCaption.textContent = galleryData[activeIndex].alt;
    };

    const openLightbox = (index) => {
      if (!lightbox || galleryData.length === 0) return;
      activeIndex = index;
      renderLightbox();
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.hidden = true;
      document.body.style.overflow = '';
    };

    openButtons.forEach((button, index) => {
      button.addEventListener('click', () => openLightbox(index));
    });

    closeButton?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    prevLightboxButton?.addEventListener('click', () => {
      if (galleryData.length === 0) return;
      activeIndex = (activeIndex - 1 + galleryData.length) % galleryData.length;
      renderLightbox();
    });

    nextLightboxButton?.addEventListener('click', () => {
      if (galleryData.length === 0) return;
      activeIndex = (activeIndex + 1) % galleryData.length;
      renderLightbox();
    });

    document.addEventListener('keydown', (event) => {
      if (!lightbox || lightbox.hidden) return;
      if (event.key === 'Escape') closeLightbox();
      if (event.key === 'ArrowLeft' && galleryData.length > 0) {
        activeIndex = (activeIndex - 1 + galleryData.length) % galleryData.length;
        renderLightbox();
      }
      if (event.key === 'ArrowRight' && galleryData.length > 0) {
        activeIndex = (activeIndex + 1) % galleryData.length;
        renderLightbox();
      }
    });

    const coreSticky = document.querySelector('[data-core-sticky]');
    const priceSummary = document.querySelector('[data-price-summary]');
    const priceToggle = document.querySelector('[data-price-toggle]');
    const compactMedia = window.matchMedia('(max-width: 720px)');

    const updatePriceToggleLabel = (expanded) => {
      if (!priceToggle) return;
      priceToggle.textContent = expanded ? '접기' : '펼치기';
      priceToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      priceSummary?.classList.toggle('is-collapsed', !expanded);
    };

    if (priceToggle && priceSummary) {
      updatePriceToggleLabel(true);
      priceToggle.addEventListener('click', () => {
        const expanded = priceToggle.getAttribute('aria-expanded') === 'true';
        updatePriceToggleLabel(!expanded);
      });
    }

    const updateCoreStickyCompact = () => {
      if (!coreSticky) return;
      if (!compactMedia.matches) {
        coreSticky.classList.remove('is-compact');
        return;
      }

      const topOffset = Number.parseFloat(getComputedStyle(coreSticky).top || '0') || 0;
      const rect = coreSticky.getBoundingClientRect();
      const isStuck = rect.top <= topOffset + 1;
      const shouldCompact = isStuck && window.scrollY > 30;
      coreSticky.classList.toggle('is-compact', shouldCompact);
    };

    updateCoreStickyCompact();
    window.addEventListener('scroll', updateCoreStickyCompact, { passive: true });
    window.addEventListener('resize', updateCoreStickyCompact, { passive: true });
    compactMedia.addEventListener?.('change', updateCoreStickyCompact);
    compactMedia.addListener?.(updateCoreStickyCompact);

    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.16 }
    );

    reveals.forEach((element) => observer.observe(element));
  </script>
</BaseLayout>

<style>
  .venue-hero {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    min-height: 360px;
    margin-bottom: 14px;
  }

  .venue-hero img {
    width: 100%;
    height: 360px;
    object-fit: cover;
    display: block;
    transform: scale(1.02);
  }

  .hero-overlay {
    position: absolute;
    inset: auto 0 0;
    padding: 28px;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.04) 0%, rgba(15, 23, 42, 0.86) 80%);
    color: #f8fafc;
  }

  .hero-overlay p {
    margin: 0 0 8px;
    font-size: 0.92rem;
    opacity: 0.92;
  }

  .hero-overlay h1 {
    margin: 0;
    font-size: clamp(1.5rem, 3.4vw, 2.3rem);
    line-height: 1.2;
  }

  .hero-lead {
    margin-top: 10px;
    font-size: 0.97rem;
    line-height: 1.55;
    max-width: 840px;
  }

  .venue-core-sticky {
    position: sticky;
    top: calc(var(--site-menu-tabs-top, 8px) + var(--site-menu-tabs-height, 0px) + var(--site-menu-stack-gap, 8px));
    z-index: 25;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 16px;
    backdrop-filter: blur(8px);
    transition: gap 0.2s ease, transform 0.2s ease;
  }

  .core-card {
    padding: 12px 14px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(10, 12, 18, 0.86);
    transition: padding 0.2s ease, border-radius 0.2s ease, opacity 0.2s ease;
  }

  .core-card span {
    display: block;
    font-size: 0.78rem;
    color: #9ca8c2;
    margin-bottom: 4px;
    transition: opacity 0.18s ease, max-height 0.18s ease, margin-bottom 0.18s ease;
  }

  .core-card strong {
    font-size: 0.95rem;
    color: #f6f9ff;
    transition: font-size 0.18s ease;
  }

  .core-card .price-summary {
    display: block;
    white-space: pre-line;
    line-height: 1.5;
  }

  .core-card .price-summary.is-collapsed {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .price-toggle {
    margin-top: 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: #dbe8ff;
    min-height: 28px;
    padding: 0 10px;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }

  .venue-grid {
    display: block;
  }

  .venue-main {
    max-width: 920px;
    margin: 0 auto;
  }

  .section-block {
    margin: 18px 0;
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    background: rgba(8, 10, 14, 0.92);
  }

  .section-block h2 {
    margin: 0 0 12px;
    font-size: 1.2rem;
    color: #ffe84a;
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
  }

  .timeline-index {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    height: 36px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.84rem;
    background: #0f172a;
    color: #f8fafc;
  }

  .timeline-item h3 {
    margin: 0;
    font-size: 1rem;
    color: #f4f8ff;
  }

  .timeline-item p {
    margin: 6px 0 0;
    color: #d7deef;
    line-height: 1.6;
  }

  .gallery-shell {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    gap: 8px;
    align-items: center;
  }

  .gallery-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 10px;
    scrollbar-width: none;
  }

  .gallery-track::-webkit-scrollbar {
    display: none;
  }

  .gallery-slide {
    border: 0;
    padding: 0;
    cursor: zoom-in;
    border-radius: 14px;
    overflow: hidden;
    scroll-snap-align: start;
    background: #0f172a;
  }

  .gallery-slide img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    display: block;
  }

  .gallery-nav {
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 12px;
    background: rgba(14, 17, 24, 0.96);
    color: #f7fbff;
    font-size: 1.35rem;
    cursor: pointer;
  }

  .gallery-dots {
    display: flex;
