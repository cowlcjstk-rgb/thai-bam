---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const [areas, categories, venues] = await Promise.all([getCollection('areas'), getCollection('categories'), getCollection('venues')]);
  const visible = venues.filter((v) => v.data.visible);
  const paths = [];
  for (const area of areas) {
    for (const category of categories) {
      const matched = visible.filter((v) => v.data.area === area.slug && v.data.category === category.slug);
      if (matched.length >= 3 && area.data.intro.length >= 80 && category.data.intro.length >= 80) {
        paths.push({ params: { area: area.slug, category: category.slug }, props: { area, category, matched } });
      }
    }
  }
  return paths;
}

const { area, category, matched } = Astro.props;
const title = `${area.data.name} ${category.data.name} 추천 업체 | 브랜드명`;
const description = `${area.data.name} 지역의 ${category.data.name} 업체 정보, 위치, 영업시간, 연락 방법을 확인하세요.`;
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: new URL(Astro.url.pathname, Astro.site).toString() };
---
<BaseLayout title={title} description={description}>
  <JsonLd data={jsonLd} />
  <h1>{area.data.name} {category.data.name} 추천 업체</h1>
  <p>{area.data.intro}</p>
  <div class="grid">{matched.map((v) => <a class="card" href={`/venue/${v.slug}/`}>{v.data.title}</a>)}</div>
</BaseLayout>
