---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import BannerSlot from '../components/BannerSlot.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const [areas, allVenues] = await Promise.all([
  getCollection('areas'),
  getCollection('venues'),
]);

const sortedAreas = areas.sort((a, b) => a.data.order - b.data.order);
const venues = allVenues
  .filter((venue) => venue.data.visible && venue.data.category === category.slug)
  .sort((a, b) => a.data.order - b.data.order);
const resolveVenueSlug = (entry) => entry.data.slug?.trim() || entry.slug;

const getThumbPosition = (position) => {
  if (position === 'top') return 'center top';
  if (position === 'bottom') return 'center bottom';
  return 'center center';
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: category.data.seoTitle,
  description: category.data.seoDescription,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<BaseLayout title={category.data.seoTitle} description={category.data.seoDescription} noindex={!category.data.indexable}>
  <JsonLd data={jsonLd} />

  <div class="directory-page">
    <section class="directory-hero">
      <h1>{category.data.name}</h1>
      <p>{category.data.intro}</p>
      <div class="directory-meta">
        <span class="directory-chip">카테고리: {category.data.name}</span>
        <span class="directory-chip">등록 업체: {venues.length}개</span>
      </div>
    </section>

    <BannerSlot position="category_top" />

    <section class="directory-section">
      <h2>지역별 바로가기</h2>
      <div class="directory-grid">
        {sortedAreas.map((area) => {
          const sample = venues.find((venue) => venue.data.area === area.slug);
          const targetHref = sample ? `/${area.slug}/${category.slug}/` : `/${area.slug}/`;
          return (
            <a class="directory-card" href={targetHref}>
              {sample && (
                <img
                  src={sample.data.thumbnail}
                  alt={sample.data.thumbnailAlt}
                  width="900"
                  height="560"
                  loading="lazy"
                  style={`object-position:${getThumbPosition(sample.data.thumbnailPosition)};`}
                />
              )}
              <div class="directory-card-body">
                <p class="directory-card-meta">{area.data.name}</p>
                <h3>{area.data.name} {category.data.name}</h3>
                <p>{sample ? sample.data.shortDescription : `${area.data.name} 지역 ${category.data.name} 목록으로 이동합니다.`}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <section class="directory-section">
      <h2>추천 업체</h2>
      <div class="directory-grid">
        {venues.map((venue) => (
          <a class="directory-card" href={`/venue/${resolveVenueSlug(venue)}/`}>
            <img
              src={venue.data.thumbnail}
              alt={venue.data.thumbnailAlt}
              width="900"
              height="560"
              loading="lazy"
              style={`object-position:${getThumbPosition(venue.data.thumbnailPosition)};`}
            />
            <div class="directory-card-body">
              <p class="directory-card-meta">{venue.data.area} · {category.data.name}</p>
              <h3>{venue.data.title}</h3>
              <p>{venue.data.shortDescription}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
